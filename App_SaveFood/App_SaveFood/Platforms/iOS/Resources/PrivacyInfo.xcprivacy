<?xml version="1.0" encoding="UTF-8"?>
<!--
This is the minimum required version of the Apple Privacy Manifest for .NET MAUI apps.
The contents below are needed because of App_SaveFoods that are used in the .NET framework and .NET MAUI SDK.

You are responsible for adding extra entries as needed for your application.

More information: https://aka.ms/maui-privacy-manifest
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyAccessedApp_SaveFoodTypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedApp_SaveFoodType</key>
            <string>NSPrivacyAccessedApp_SaveFoodCategoryFileTimestamp</string>
            <key>NSPrivacyAccessedApp_SaveFoodTypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedApp_SaveFoodType</key>
            <string>NSPrivacyAccessedApp_SaveFoodCategorySystemBootTime</string>
            <key>NSPrivacyAccessedApp_SaveFoodTypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedApp_SaveFoodType</key>
            <string>NSPrivacyAccessedApp_SaveFoodCategoryDiskSpace</string>
            <key>NSPrivacyAccessedApp_SaveFoodTypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
        <!--
            The entry below is only needed when you're using the Preferences App_SaveFood in your app.
        <dict>
            <key>NSPrivacyAccessedApp_SaveFoodType</key>
            <string>NSPrivacyAccessedApp_SaveFoodCategoryUserDefaults</string>
            <key>NSPrivacyAccessedApp_SaveFoodTypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict> -->
    </array>
</dict>
</plist>
