<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_SaveFood.CadastroPage"
             >
    <VerticalStackLayout VerticalOptions="Center">
        <Border WidthRequest="500" HeightRequest="700" StrokeThickness="1" StrokeShape="RoundRectangle 100" Padding="20">
            <VerticalStackLayout HorizontalOptions="Center" Padding="50">
                <Label Text="Crie sua Conta" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,0,0,50"/>
                <VerticalStackLayout WidthRequest="350" Padding="10" VerticalOptions="Center">
                    <Entry Placeholder="Nome Completo" x:Name="txtNome"/>
                    <Entry Placeholder="Email" x:Name="txtEmail"/>
                    <Entry Placeholder="Senha" x:Name="txtSenha"/>
                    <Entry Placeholder="Confirmar Senha" x:Name="txtConfirmarSenha"/>

                    <Button Text="Criar Conta" FontAttributes="Bold" FontSize="16" Margin="0,150,0,0" CornerRadius="50"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>