<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_SaveFood.ConfigPage"
             Title="Configurações"
             IconImageSource="configuracoes.png">
    <VerticalStackLayout>
        <Grid BackgroundColor="DarkSeaGreen">
            <HorizontalStackLayout Padding="20,10,20,20" Spacing="15">
                <Image Source="usuario.png" WidthRequest="70"/>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Olá, user" FontSize="24" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="user@email.com" FontSize="14" TextColor="White" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>
        
        <Label Text="Configurações" FontAttributes="Bold" FontSize="32" Margin="30,30,0,50"/>
        <Grid HorizontalOptions="Center" >
            <Frame WidthRequest="140" HeightRequest="140" CornerRadius="70" Padding="0" BackgroundColor="#D9D9D9" HasShadow="False">
                <Image Source="usuario.png"/>
            </Frame>

            <Frame WidthRequest="55" HeightRequest="55" CornerRadius="40" BackgroundColor="Green" Padding="0" HorizontalOptions="End" VerticalOptions="End" Margin="200,0,0,0">
                <ImageButton Source="camera.png" BackgroundColor="Transparent" WidthRequest="20"/>
            </Frame>
        </Grid>

        <VerticalStackLayout Margin="80,90,0,0">
            <HorizontalStackLayout>
                <Switch/>
                <Label Text="Permanecer logado" VerticalTextAlignment="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout >
                <Switch/>
                <Label Text="Modo escuro" VerticalTextAlignment="Center"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>