<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_SaveFood.ConfigPage"
             Title="Configurações"
             IconImageSource="configuracoes.png">
    <VerticalStackLayout>
        <Grid BackgroundColor="DarkSeaGreen">
            <HorizontalStackLayout Padding="20,10,20,20" Spacing="15">
                <Image Source="usuario.png" WidthRequest="70"/>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Olá, user" FontSize="24" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="user@email.com" FontSize="14" TextColor="White" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>
        
        <Label Text="Configurações" FontAttributes="Bold" FontSize="32" Margin="30,30,0,30"/>
        <Grid HorizontalOptions="Center">
            <Frame WidthRequest="140" HeightRequest="140" CornerRadius="70" Padding="0" BackgroundColor="#D9D9D9" HasShadow="False">
                <Image Source="usuario.png"/>
            </Frame>
        </Grid>
    </VerticalStackLayout>
</ContentPage>