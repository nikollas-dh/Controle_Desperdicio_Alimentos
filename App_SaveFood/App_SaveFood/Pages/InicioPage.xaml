<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_SaveFood.inicioPage"
             Title="Início"
             IconImageSource="home.png">
    <VerticalStackLayout>
        <Grid BackgroundColor="DarkSeaGreen">
            <HorizontalStackLayout
                Padding="20,10,20,20"
                Spacing="15">
                <Image
                        Source="usuario.png"
                        Aspect="AspectFill"
                        WidthRequest="70"
                        HeightRequest="70"/>
                <VerticalStackLayout
                    VerticalOptions="Center">
                    <Label
                        Text="Olá, user"
                        FontAttributes="Bold"
                        FontSize="22"
                        TextColor="White"/>
                    <Label
                        Text="user@email.com"
                        TextColor="White"
                        FontSize="14"/>

                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>